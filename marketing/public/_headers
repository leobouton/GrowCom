# En-têtes de sécurité de toutes les pages et fichiers du site (Cloudflare Workers, fichiers statiques).
# CSP : scripts, cadres et connexions limités au site et aux deux services Cloudflare utilisés
# (Turnstile pour l'anti-robot du formulaire, Web Analytics pour les statistiques sans cookie).
# 'unsafe-inline' reste nécessaire pour les scripts d'activation d'Astro et les styles en ligne ;
# le site n'affiche aucun contenu saisi par des tiers.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Modèles à télécharger : proposés en téléchargement, pas affichés dans le navigateur
/modele/*
  Content-Disposition: attachment
