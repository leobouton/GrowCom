---
import Logo from './Logo.astro';
import { NAV_LINKS, ROUTES } from '../lib/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(`${href}/`));
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md supports-[backdrop-filter]:bg-paper/75">
  <a
    href="#contenu"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
  >
    Aller au contenu
  </a>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <Logo />

    <nav aria-label="Navigation principale" class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-3.5 py-2 text-[0.94rem] font-medium transition-colors',
              isActive(link.href) ? 'text-ink' : 'text-ink-soft hover:text-ink',
            ]}
          >
            {link.label}
            {isActive(link.href) && (
              <span aria-hidden="true" class="absolute inset-x-3.5 -bottom-[3px] h-[3px] rounded-full bg-lime" />
            )}
          </a>
        ))
      }
      <a href={ROUTES.simulator} class="btn btn-primary ml-3 !min-h-10 !px-4 !py-2 text-[0.9rem]">
        Faire une simulation
      </a>
    </nav>

    <!-- Menu mobile sans JavaScript : un simple <details> -->
    <details class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line-strong text-ink [&::-webkit-details-marker]:hidden"
        aria-label="Ouvrir le menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" class="group-open:hidden">
          <path d="M3 6h14M3 10h14M3 14h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" class="hidden group-open:block">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav
        aria-label="Navigation mobile"
        class="absolute right-0 top-14 w-[min(19rem,calc(100vw-2.5rem))] rounded-2xl border border-line bg-card p-2 shadow-[var(--shadow-slip)]"
      >
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="flex items-center justify-between rounded-xl px-4 py-3 text-[1rem] font-medium text-ink hover:bg-paper"
            >
              {link.label}
              {isActive(link.href) && <span aria-hidden="true" class="h-2 w-2 rounded-full bg-lime ring-[1.5px] ring-ink" />}
            </a>
          ))
        }
        <a href={ROUTES.simulator} class="btn btn-primary mt-2 w-full">Faire une simulation</a>
      </nav>
    </details>
  </div>
</header>
