---
import Logo from './Logo.astro';
import { ROUTES, SITE, DEMO_HREF } from '../lib/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Outils gratuits',
    links: [
      { href: ROUTES.simulator, label: 'Simulateur de commission' },
      { href: ROUTES.template, label: 'Modèle de grille de commissionnement' },
      { href: ROUTES.blog, label: 'Blog' },
    ],
  },
  {
    title: 'GrowCom',
    links: [
      { href: DEMO_HREF, label: 'Demander une démo' },
      { href: `mailto:${SITE.contactEmail}`, label: SITE.contactEmail },
    ],
  },
  {
    title: 'Informations',
    links: [
      { href: ROUTES.legal, label: 'Mentions légales' },
      { href: ROUTES.privacy, label: 'Politique de confidentialité' },
    ],
  },
];
---

<footer class="render-later relative mt-28 overflow-hidden bg-ink text-paper">
  <!-- La courbe du logo, en très grand, en filigrane -->
  <svg
    aria-hidden="true"
    viewBox="0 0 1200 400"
    class="pointer-events-none absolute -right-40 -top-10 h-[26rem] w-[80rem] max-w-none opacity-[0.07]"
    preserveAspectRatio="none"
  >
    <path d="M0 380c260 0 360-90 470-250C560 0 700-20 900 40" fill="none" stroke="#f7f4ee" stroke-width="22" stroke-linecap="round"></path>
  </svg>

  <div class="relative mx-auto max-w-6xl px-5 pb-10 pt-16 sm:px-8">
    <div class="grid gap-12 md:grid-cols-[1.3fr_2fr]">
      <div>
        <Logo tone="paper" />
        <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-paper/70">
          Le calcul des commissions de vos négociateurs, automatique et lisible, palier par palier.
        </p>
      </div>
      <div class="grid gap-10 sm:grid-cols-3">
        {
          columns.map((column) => (
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-paper/55">{column.title}</h2>
              <ul class="mt-4 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="break-words text-[0.95rem] text-paper/85 transition-colors hover:text-lime">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-paper/15 pt-6 text-sm text-paper/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} GrowCom</p>
      <p>Ce site ne dépose aucun cookie de suivi.</p>
    </div>
  </div>
</footer>
