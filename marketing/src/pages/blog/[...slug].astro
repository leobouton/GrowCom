---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { formatDate } from '../../lib/format';
import { ROUTES } from '../../lib/site';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishedAt, updatedAt } = post.data;
---

<BaseLayout title={`${title} | GrowCom`} description={description}>
  <article>
    <header class="relative isolate overflow-hidden border-b border-line">
      <div aria-hidden="true" class="absolute -right-24 -top-32 -z-10 h-80 w-80 rounded-full bg-lime/30 blur-3xl"></div>
      <div class="mx-auto max-w-3xl px-5 pb-12 pt-12 sm:px-8 md:pt-16">
        <a href={ROUTES.blog} class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-ink">
          <span class="rotate-180"><ArrowIcon /></span>
          Tous les articles
        </a>
        <h1 class="display mt-8 text-[2.2rem] text-ink sm:text-[3rem]">{title}</h1>
        <p class="mt-6 text-[1.15rem] leading-relaxed text-ink-soft">{description}</p>
        <p class="num mt-6 text-sm text-muted">
          Publié le <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
          {
            updatedAt && (
              <>
                {' · '}mis à jour le <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
              </>
            )
          }
        </p>
      </div>
    </header>

    <div class="prose-gc mx-auto max-w-3xl px-5 py-14 sm:px-8">
      <Content />
    </div>
  </article>

  <aside class="mx-auto max-w-3xl px-5 sm:px-8">
    <div class="rounded-[1.4rem] bg-ink px-7 py-9 text-paper sm:px-10">
      <p class="display text-[1.7rem] text-paper">Testez votre grille sur vos propres chiffres.</p>
      <p class="mt-3 text-paper/75">Paliers par tranche ou au taux atteint, partage des ventes : le calcul détaillé en quelques secondes.</p>
      <a href={ROUTES.simulator} class="btn btn-lime mt-6">
        Ouvrir le simulateur
        <ArrowIcon />
      </a>
    </div>
  </aside>
</BaseLayout>
