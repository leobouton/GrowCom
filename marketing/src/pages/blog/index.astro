---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { formatDate } from '../../lib/format';
import { ROUTES } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout
  title="Blog · Rémunération et commissions des négociateurs immobiliers | GrowCom"
  description="Grilles de commissionnement, paliers, partage des ventes, statut des négociateurs : des articles concrets pour les directeurs d'agence immobilière."
>
  <PageHero
    eyebrow="Blog"
    title="Rémunération des négociateurs : <em>les bons calculs.</em>"
    lead="Des articles concrets, chiffrés, pour les directeurs d'agence qui veulent une rémunération variable juste et lisible."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    {
      posts.length === 0 ? (
        <p class="text-ink-soft">Les premiers articles arrivent bientôt.</p>
      ) : (
        <ul class="divide-y divide-line border-y border-line">
          {posts.map((post) => (
            <li>
              <a
                href={`${ROUTES.blog}/${post.id}`}
                class="group grid gap-3 py-9 transition-colors md:grid-cols-[10rem_1fr_auto] md:items-baseline md:gap-10"
              >
                <time datetime={post.data.publishedAt.toISOString()} class="num text-sm text-muted">
                  {formatDate(post.data.publishedAt)}
                </time>
                <div>
                  <h2 class="display text-[1.6rem] leading-snug text-ink transition-colors group-hover:text-primary-700 sm:text-[1.9rem]">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">{post.data.description}</p>
                </div>
                <span class="hidden h-11 w-11 items-center justify-center rounded-full border border-line-strong text-ink transition-all group-hover:border-ink group-hover:bg-lime md:flex">
                  <ArrowIcon />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
